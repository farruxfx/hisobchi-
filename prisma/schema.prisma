generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  FINAL
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum SalaryType {
  MONTHLY
  HOURLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  departmentId String?
  positionId   String?
  hireDate     DateTime
  salaryType   SalaryType
  baseSalary   Decimal? @db.Decimal(12, 2)
  hourlyRate   Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)

  department   Department? @relation(fields: [departmentId], references: [id])
  position     Position?   @relation(fields: [positionId], references: [id])
  user         User?
  attendance   AttendanceLog[]
  timesheets   Timesheet[]
  payslips     Payslip[]
  requests     Request[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Position {
  id        String     @id @default(cuid())
  title     String
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AttendanceLog {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  source     String
  editedBy   String?

  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model Timesheet {
  id            String          @id @default(cuid())
  employeeId    String
  date          DateTime
  hoursWorked   Decimal         @db.Decimal(5, 2)
  overtimeHours Decimal         @db.Decimal(5, 2)
  status        TimesheetStatus
  approvedBy    String?

  employee      Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model PayrollRun {
  id        String        @id @default(cuid())
  month     Int
  year      Int
  status    PayrollStatus
  createdBy String
  payslips  Payslip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  employeeId   String
  gross        Decimal    @db.Decimal(12, 2)
  deductions   Decimal    @db.Decimal(12, 2)
  allowances   Decimal    @db.Decimal(12, 2)
  net          Decimal    @db.Decimal(12, 2)
  detailsJson  Json

  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee     Employee   @relation(fields: [employeeId], references: [id])
}

model Vendor {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  inn       String?
  expenses  Expense[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id             String   @id @default(cuid())
  date           DateTime
  category       String
  amount         Decimal  @db.Decimal(12, 2)
  vendorId       String?
  note           String?
  attachmentPath String?
  createdBy      String

  vendor         Vendor? @relation(fields: [vendorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  date      DateTime
  vendorId  String
  amount    Decimal       @db.Decimal(12, 2)
  status    InvoiceStatus
  dueDate   DateTime?
  paidAt    DateTime?

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id                   String        @id @default(cuid())
  employeeId           String
  type                 String
  fromDate             DateTime?
  toDate               DateTime?
  amount               Decimal?      @db.Decimal(12, 2)
  reason               String
  status               RequestStatus
  managerDecisionBy    String?
  accountantDecisionBy String?

  employee             Employee @relation(fields: [employeeId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
